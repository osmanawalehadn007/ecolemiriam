# Modèle des secrets du dépôt. Copier ce fichier en `.github-secrets.env` (jamais versionné),
# remplir les valeurs, puis lancer : bash scripts/github/configurer-depot.sh
#
# Format : NOM=valeur            (une seule ligne, sans guillemets)
#          NOM=@/chemin/fichier  (valeur lue dans un fichier : clé SSH, config rclone…)
# Une valeur laissée vide est demandée au clavier (saisie masquée) ; pour un secret
# optionnel, appuyer sur Entrée la passe.

# --- Application ---
AUTH_SECRET=
AUTH_URL=
APP_URL=
NEXT_PUBLIC_APP_URL=
# Attention : vérifier si la base de production est Supabase ou celle du serveur.
DATABASE_URL=
DIRECT_URL=
RLS_ACTIVE=
CRON_SECRET=

# --- Serveur de déploiement ---
VPS_HOST=
VPS_USER=
VPS_SSH_PORT=
VPS_SSH_PRIVATE_KEY=@

# --- Optionnels (sauvegardes, analyse de code, Turnstile) ---
BACKUP_AGE_KEY=
BACKUP_AGE_KEY_PRIVATE=
BACKUP_RCLONE_CONFIG=@
SEMGREP_APP_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
