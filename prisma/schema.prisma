// ============================================================
// JOURNAL DES EMAILS TRANSACTIONNELS
// ============================================================

enum TypeEmail {
  VERIFICATION       // Email de vérification d'adresse (création de compte)
  PASSWORD_RESET     // Réinitialisation de mot de passe
  NOTIFICATION       // Notification diffusée (canal email)
  ADMISSION          // Facture/lien d'admission
  RELANCE            // Relance de facture
  AUTRE              // Autre email transactionnel
}

enum StatutEmail {
  PENDING     // En attente d'envoi
  SENT        // Envoyé à Resend (ID reçu)
  DELIVERED   // Délivré au serveur de messagerie (webhook)
  BOUNCED     // Rejeté par le serveur de messagerie (webhook)
  FAILED      // Échec d'envoi (erreur API Resend)
  COMPLAINED  // Marqué comme spam par le destinataire (webhook)
  OPENED      // Ouvert par le destinataire (webhook)
  DELIVERY_DELAYED // Délai de livraison temporaire (webhook)
}

model EmailLog {
  id        String      @id @default(cuid())
  tenantId  String?
  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Destinataire
  userId    String?
  user      User?       @relation("EmailLogRecipient", fields: [userId], references: [id], onDelete: SetNull)
  email     String      // adresse email du destinataire

  // Contenu
  type      TypeEmail
  subject   String
  status    StatutEmail @default(PENDING)

  // Corrélation avec Resend
  resendEmailId String? // ID retourné par l'API Resend pour les webhooks

  // Détails d'erreur / diagnostic
  errorMessage  String? @db.Text
  bounceReason  String? @db.Text

  // Horodatage des événements
  sentAt        DateTime?
  deliveredAt   DateTime?
  bouncedAt     DateTime?
  openedAt      DateTime?
  complainedAt  DateTime?

  // Métadonnées
  createdBy String? // ID de l'utilisateur qui a déclenché l'envoi
  tags      Json?   // tags Resend (ex: { category: "verification" })

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([email])
  @@index([resendEmailId])
  @@index([status])
  @@map("email_logs")
}

