// ============================================================
// École Miriam — Schéma Prisma Multi-Tenant
// Strategy: Row-level isolation via tenantId sur toutes les tables
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // Prisma >= 5.9.0: prepared statements sont activés par défaut
  // sauf si pgbouncer=true dans l'URL (mode transaction).
  // Pour les activer explicitement en mode session, utiliser:
  // relationMode = "foreignKeys" (déjà le défaut)
}

// ============================================================
// PLANS & ABONNEMENTS
// ============================================================

enum PlanType {
  STARTER // < 200 élèves — 49€/mois
  PRO // 200-1000 élèves — 149€/mois
  BUSINESS // 1000-5000 élèves — 399€/mois
  ENTERPRISE // > 5000 élèves — sur devis
}

enum TenantStatus {
  TRIAL // Période d'essai (30 jours)
  ACTIVE // Abonnement actif
  SUSPENDED // Suspendu (impayé)
  CANCELLED // Résilié
}

// ============================================================
// TENANT (Établissement scolaire)
// ============================================================

model Tenant {
  id          String       @id @default(cuid())
  name        String // "Lycée Omar Bongo"
  slug        String       @unique // "lycee-omar-bongo" → sous-domaine
  domain      String?      @unique // domaine personnalisé optionnel
  logoUrl     String?
  plan        PlanType     @default(STARTER)
  status      TenantStatus @default(TRIAL)
  trialEndsAt DateTime?

  // Informations légales
  address String?
  city    String?
  country String  @default("SN") // Code ISO pays
  phone   String?
  email   String?
  website String?
  siret   String? // Numéro d'agrément

  // Configuration pédagogique
  currentYear String @default("2025-2026")
  notationMax Int    @default(20) // Notation sur 20 ou 100
  langue      String @default("fr")
  timezone    String @default("Africa/Dakar")
  currency    String @default("XOF") // Franc CFA

  // Couleurs de marque
  primaryColor   String?
  secondaryColor String?

  // Signature & cachet pour documents officiels (bulletins, attestations)
  signatureUrl       String?
  cachetUrl          String?
  chefEtablissement  String?

  // Stripe
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users          User[]
  userTenants    UserTenant[]
  userPermissions UserPermission[]
  annees         AnneesScolaires[]
  classes        Classe[]
  matieres       Matiere[]
  eleves         Eleve[]
  parents        Parent[]
  enseignants    Enseignant[]
  absences       Absence[]
  notes          Note[]
  examens        Examen[]
  factures       Facture[]
  evenements     Evenement[]
  incidents      Incident[]
  candidatures   Candidature[]
  notifications  Notification[]
  alumni         Alumni[]
  inventaire     ItemInventaire[]
  evaluations    Evaluation[]
  disponibilites DisponibiliteEnseignant[]
  indisponibilitesEnseignant IndisponibiliteEnseignant[]
  salles         Salle[]
  sites          Site[]
  structures     Structure[]
  reglesAppreciation ReglesAppreciation[]
  dispenses          DispenseMatiere[]
  absencesPersonnel  AbsencePersonnel[]
  depenses           Depense[]
  budgets            Budget[]
  remisesCaisse      RemiseCaisse[]
  congesPersonnel    CongePersonnel[]
  conversations      Conversation[]
  tarifsNiveau       TarifNiveau[]
  relances           Relance[]
  exclusionsEleve    ExclusionEleve[]
  enseignantMatieres    EnseignantMatiere[]
  enseignantAffectations EnseignantAffectation[]
  cahierTextes          CahierTexte[]
  cahierTexteCommentaires CahierTexteCommentaire[]
  devoirs               Devoir[]
  chapitres             Chapitre[]

  // Fournitures scolaires
  fournitureListes FournitureListe[]

  // Journal des emails transactionnels
  emailLogs EmailLog[]

  @@map("tenants")
}

// ============================================================
// SITES / CAMPUSES (multi-sites au sein d'un même tenant)
// ============================================================

model Site {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nom      String // "Campus Central", "Annexe PK12"
  code     String? // "SITE-01"
  adresse  String?
  ville    String?
  telephone String?
  email    String?
  actif    Boolean @default(true)

  classes      Classe[]
  salles       Salle[]
  factures     Facture[]
  users        User[]
  eleves       Eleve[]
  examens      Examen[]
  evenements   Evenement[]
  notifications Notification[]
  candidatures Candidature[]
  alumni       Alumni[]
  inventaire   ItemInventaire[]
  cours        Cours[]
  matieres     Matiere[]
  structures   Structure[]
  disponibilitesEnseignant DisponibiliteEnseignant[]
  indisponibilitesEnseignant IndisponibiliteEnseignant[]
  conversations Conversation[] @relation("ConversationSite")

  // Enseignants multi-sites
  enseignantSites EnseignantSite[]

  // Users multi-sites
  userSites UserSite[]

  // Cahier de texte
  cahierTextes CahierTexte[]
  devoirs      Devoir[]
  chapitres    Chapitre[]

  // Tarifs par niveau
  tarifsNiveau TarifNiveau[]
  depenses     Depense[]
  budgets      Budget[]
  remisesCaisse RemiseCaisse[]

  // Fournitures scolaires
  fournitureListes FournitureListe[]

  // Soft-delete / purge planifiée (Option B — industry standard)
  deletedAt        DateTime?
  deletedBy        String?
  deletedReason    String?
  scheduledPurgeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("sites")
}

// ============================================================
// JOURNAL D'AUDIT — SUPPRESSION DE SITES
// Conserve une trace permanente même après purge définitive.
// ============================================================

model SiteDeletionLog {
  id             String   @id @default(cuid())
  tenantId       String
  siteId         String
  siteNom        String
  action         String   // "SOFT_DELETE" | "RESTORE" | "PURGE"
  reason         String?
  performedBy    String
  performedByName String?
  performedAt    DateTime @default(now())
  metadata       Json?

  @@index([tenantId])
  @@index([siteId])
  @@map("site_deletion_logs")
}

// Table de liaison User ↔ Site (accès multi-sites pour tout utilisateur)
model UserSite {
  id        String @id @default(cuid())
  userId    String
  siteId    String
  role      Role?  // null = hérite du rôle global (User.role)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime?

  @@unique([userId, siteId])
  @@index([userId])
  @@index([siteId])
  @@map("user_sites")
}

// Table de liaison pour les enseignants qui travaillent sur plusieurs sites
model EnseignantSite {
  id           String @id @default(cuid())
  enseignantId String
  siteId       String

  enseignant Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([enseignantId, siteId])
  @@index([enseignantId])
  @@index([siteId])
  @@map("enseignant_sites")
}

// ============================================================
// ANNÉE SCOLAIRE
// ============================================================

model AnneesScolaires {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  libelle   String // "2025-2026"
  dateDebut DateTime
  dateFin   DateTime
  isCurrent Boolean  @default(false)

  periodes Periode[]

  @@index([tenantId])
  @@map("annees_scolaires")
}

model Periode {
  id      String          @id @default(cuid())
  anneeId String
  annee   AnneesScolaires @relation(fields: [anneeId], references: [id], onDelete: Cascade)

  nom       String // "Trimestre 1", "Semestre 1"
  numero    Int // 1, 2, 3
  dateDebut DateTime
  dateFin   DateTime
  isCurrent Boolean  @default(false)

  // Clôture / prolongation de période
  statut           String  @default("OUVERTE") // OUVERTE | CLOTUREE
  cloturedAt       DateTime?
  dateLimiteSaisie DateTime? // prolongation exceptionnelle

  notes       Note[]
  bulletins   Bulletin[]
  evaluations Evaluation[]
  chapitres   Chapitre[]

  @@index([anneeId])
  @@map("periodes")
}

// ============================================================
// UTILISATEURS & AUTHENTIFICATION
// ============================================================

enum Role {
  SUPER_ADMIN // Équipe École Miriam
  TENANT_ADMIN // Directeur/Propriétaire
  PRINCIPAL // Chef d'établissement
  SECRETARY // Secrétariat
  TEACHER // Enseignant
  CLASS_TEACHER // Professeur principal
  COUNSELOR // Conseiller d'orientation / CPE
  NURSE // Infirmier(e)
  ACCOUNTANT // Gestionnaire financier
  PARENT // Parent / Tuteur légal
  STUDENT // Élève
}

model User {
  id       String  @id @default(cuid())
  tenantId String? // null pour SUPER_ADMIN
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = tous les sites (direction générale)
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  email         String    @unique
  emailVerified DateTime?
  password      String? // hashé avec bcrypt
  mfaSecret     String? // secret TOTP chiffré (base32) pour 2FA
  mfaEnabled    Boolean   @default(false) // 2FA activée ?
  name          String
  firstName     String?
  lastName      String?
  avatarUrl     String?
  phone         String?

  role        Role      @default(TEACHER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  // Préférences
  langue        String @default("fr")
  locale        String @default("fr") // FR ou EN pour l'interface
  notifications Json? // { email: true, sms: false, push: true }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // Relations métier
  enseignants Enseignant[]
  parents     Parent[]
  eleve      Eleve?

  // Messagerie
  messagesSent        Message[]                 @relation("MessageSender")
  conversationsJoined ConversationParticipant[]
  conversationsCreated Conversation[]           @relation("ConversationCreator")

  // Vie scolaire
  incidentsRapportes Incident[] @relation("IncidentReporter")

  // Notifications envoyées
  notificationsEnvoyees Notification[] @relation("NotificationSender")

  // Appareils mobiles (push)
  devices DeviceToken[] @relation("UserDevices")

  // Multi-tenant: liste des tenants accessibles
  userTenants UserTenant[]

  // Multi-site: liste des sites accessibles
  userSites UserSite[]

  // Permissions personnalisées (surcharge du rôle)
  customPermissions UserPermission[]

  // Factures & paiements créés par cet utilisateur
  facturesCrees    Facture[]  @relation("FactureCreePar")
  paiementsEnregistres Paiement[] @relation("PaiementEnregistrePar")
  paiementsDeposes Paiement[] @relation("PaiementDeposePar")
  paiementsDirectorRecu Paiement[] @relation("PaiementDirectorRecuPar")
  depensesCrees    Depense[] @relation("DepenseCreePar")
  depensesAutorisees Depense[] @relation("DepenseAutorisePar")
  depensesPayees   Depense[] @relation("DepensePayePar")
  budgetsCrees     Budget[]  @relation("BudgetCreePar")

  // Remises de caisse: caissier et destinataire
  remisesCaissier     RemiseCaisse[] @relation("RemiseCaissier")
  remisesDestinataire RemiseCaisse[] @relation("RemiseDestinataire")
  remisesRecues       RemiseCaisse[] @relation("RemiseRecuePar")

  // Relances envoyées et exclusions décidées/levées
  relancesEnvoyees   Relance[]       @relation("RelanceEnvoyeePar")
  exclusionsDecidees ExclusionEleve[] @relation("ExclusionDecideePar")
  exclusionsLevees   ExclusionEleve[] @relation("ExclusionLeveePar")

  // Absences & congés du personnel saisis par cet utilisateur
  absencesPersonnelSaisies AbsencePersonnel[] @relation("AbsencePersonnelSaisiePar")
  congesDemandes           CongePersonnel[]   @relation("CongeDemandePar")
  congesApprouves          CongePersonnel[]   @relation("CongeApprouvePar")

  // Cahier de texte saisi par cet utilisateur
  cahierTextesSaisis CahierTexte[] @relation("CahierTexteSaisiePar")
  cahierTexteCommentaires CahierTexteCommentaire[] @relation("CahierTexteCommentaireAuteur")

  // Devoirs donnés par cet utilisateur
  devoirsDonnes Devoir[] @relation("DevoirDonnePar")

  // Fournitures validées par cet utilisateur (secrétariat)
  fournitureValideePar FournitureListe[] @relation("FournitureValideePar")

  // Journal des emails transactionnels envoyés à cet utilisateur
  emailLogs EmailLog[] @relation("EmailLogRecipient")

  @@index([tenantId])
  @@index([siteId])
  @@map("users")
}

// ============================================================
// USER TENANT (Jointure multi-tenant — un user peut accéder à plusieurs écoles)
// ============================================================

model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      Role     // Rôle spécifique à ce tenant
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false) // Tenant par défaut à la connexion

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId]) // Un user = une seule fois par tenant
  @@index([tenantId])
  @@map("user_tenants")
}

// ============================================================
// USER PERMISSIONS — Permissions personnalisées par utilisateur
// ============================================================
// Permet au TENANT_ADMIN de surcharger les permissions du rôle
// d'un utilisateur en cochant/décochant des actions spécifiques.
// - mode "grant" : accorde une permission non incluse dans le rôle
// - mode "deny"  : retire une permission normalement incluse dans le rôle
// La vérification se fait dans rbac.ts → userHasPermission().

model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String   // Scopé par tenant : un user peut avoir des perms différentes par établissement
  permission String  // Format "module:action" (ex: "eleves:write")
  mode      String   @default("grant") // "grant" ou "deny"

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId, permission]) // Une seule entrée par user/tenant/permission
  @@index([tenantId])
  @@index([userId])
  @@map("user_permissions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// STRUCTURE PÉDAGOGIQUE
// ============================================================

enum StructureType {
  MATERNELLE
  PRIMAIRE
  COLLEGE
  LYCEE
}

model Structure {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = structure partagée entre tous les sites
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  type     StructureType // MATERNELLE, PRIMAIRE, COLLEGE, LYCEE
  nom      String   // "Maternelle", "Primaire", etc.
  actif    Boolean  @default(true)

  classes  Classe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  // L'unicité (tenantId, siteId, type) est assurée par un index partiel créé
  // via migration SQL. Les structures ne sont JAMAIS partagées entre sites :
  // chaque site possède ses propres structures, et il est impossible d'avoir
  // deux structures du même type sur le même site.
  // Voir : prisma/migrations/fix_structure_unique_per_site.sql
  @@map("structures")
}

model Classe {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  structureId String? // null = non rattaché à une structure pédagogique
  structure   Structure? @relation(fields: [structureId], references: [id], onDelete: SetNull)

  nom         String // "Terminale A", "CM2 A"
  niveau      String // "Terminale", "CM2"
  filiere     String? // "Scientifique", "Littéraire"
  effectifMax Int     @default(40)
  annee       String // "2025-2026"

  profPrincipalId String?
  profPrincipal   Enseignant? @relation("ProfPrincipal", fields: [profPrincipalId], references: [id])

  eleves      Eleve[]
  emploiTemps EmploiTemps[]
  notes       Note[]
  evaluations Evaluation[]
  conversations Conversation[] @relation("ConversationClasse")
  enseignantAffectations EnseignantAffectation[]
  cahierTextes CahierTexte[]
  devoirs      Devoir[]
  chapitres    Chapitre[]
  sessionsExamen SessionExamen[]

  @@index([tenantId])
  @@index([siteId])
  @@index([structureId])
  @@map("classes")
}

model Matiere {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = matière partagée entre tous les sites
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  nom         String // "Mathématiques"
  code        String // "MATH"
  coefficient Float   @default(1)
  couleur     String? // couleur UI
  niveau      String? // niveau concerné (null = tous)

  notes            Note[]
  emploiTemps      EmploiTemps[]
  bulletinMatieres BulletinMatiere[]
  evaluations      Evaluation[]
  dispenses        DispenseMatiere[]
  enseignantMatieres    EnseignantMatiere[]
  enseignantAffectations EnseignantAffectation[]
  cahierTextes     CahierTexte[]
  devoirs          Devoir[]
  chapitres        Chapitre[]
  sessionsExamen   SessionExamen[]

  // Fournitures scolaires
  fournitureListes FournitureListe[]

  @@index([tenantId])
  @@index([siteId])
  @@map("matieres")
}

// ============================================================
// ÉLÈVES
// ============================================================

enum Sexe {
  M
  F
}

enum StatutEleve {
  ACTIF
  TRANSFERE
  DIPLOME
  EXCLU
  ABANDONNE
}

model Eleve {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  matricule     String // auto-généré
  nom           String
  prenom        String
  dateNaissance DateTime
  lieuNaissance String?
  nationalite   String?     @default("SN")
  sexe          Sexe        @default(M)
  photoUrl      String?
  statut        StatutEleve @default(ACTIF)

  classeId String?
  classe   Classe? @relation(fields: [classeId], references: [id])

  // Compte de connexion élève (optionnel — généré en masse depuis Paramètres/Élèves)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Santé
  groupeSanguin   String?
  allergies       String?
  besoinsSpeciaux String?

  // Régime
  regime    String? // "interne", "demi-pensionnaire", "externe"
  transport String? // ligne de transport

  // Contacts d'urgence
  contactUrgenceNom   String?
  contactUrgencePhone String?

  anneeInscription String
  numeroBoursier   String?

  /// Clé d'identité normalisée « nom|prenom|AAAA-MM-JJ » (voir lib/eleve-identity).
  /// Recalculée à chaque écriture, remise à NULL lors de l'archivage pour
  /// libérer la place. NULL n'entre pas dans la contrainte d'unicité PostgreSQL :
  /// les fiches archivées ne bloquent donc pas une réinscription.
  /// Un homonyme légitime (même nom, prénom ET date) reçoit un suffixe « #2 ».
  identiteKey String?

  /// Lot d'import ayant créé cette fiche — permet d'annuler un import entier.
  importBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete — null = actif, date = archivé/supprimé

  parents   EleveParent[]
  absences  Absence[]
  notes     Note[]
  bulletins Bulletin[]
  factures  Facture[]
  documents Document[]
  incidents Incident[]
  parcours  ParcoursScolaire[]
  dispenses DispenseMatiere[]
  exclusions ExclusionEleve[]

  @@unique([tenantId, matricule])
  /// Rend le doublon impossible, et non plus seulement détectable. Les fiches
  /// archivées portent `identiteKey = NULL` : PostgreSQL traitant les NULL
  /// comme distincts, elles ne bloquent aucune réinscription.
  @@unique([tenantId, identiteKey])
  @@index([tenantId])
  @@index([classeId])
  @@index([siteId])
  @@index([importBatchId])
  @@map("eleves")
}

// ============================================================
// PARENTS
// ============================================================

enum LienParente {
  PERE
  MERE
  TUTEUR
  AUTRE
}

model Parent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  nom            String
  prenom         String
  email          String?
  phone          String
  phone2         String?
  telegramChatId String?
  profession     String?
  adresse        String?
  photoUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enfants EleveParent[]

  @@index([tenantId])
  @@index([userId])
  @@map("parents")
}

model EleveParent {
  eleveId  String
  eleve    Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  lien      LienParente @default(PERE)
  isGardien Boolean     @default(false) // tuteur légal principal

  @@id([eleveId, parentId])
  @@index([parentId])
  @@map("eleve_parents")
}

// ============================================================
// ENSEIGNANTS
// ============================================================

model Enseignant {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matricule   String?
  specialite  String?
  typeContrat String? // CDI, CDD, Vacation
  dateEntree  DateTime?

  classesPrincipales Classe[]                  @relation("ProfPrincipal")
  emploiTemps        EmploiTemps[]
  disponibilites     DisponibiliteEnseignant[]
  indisponibilites   IndisponibiliteEnseignant[]
  ficheRH            FicheRH?
  sites              EnseignantSite[]
  absencesPersonnel  AbsencePersonnel[]
  conges             CongePersonnel[]
  matieres           EnseignantMatiere[]
  affectations       EnseignantAffectation[]
  cahierTextes       CahierTexte[]

  // Fournitures scolaires
  fournitureListes FournitureListe[]

  @@index([tenantId])
  @@index([userId])
  @@map("enseignants")
}

// ============================================================
// AFFECTATION DES ENSEIGNANTS — matières & classes
// ============================================================

// Lien enseignant ↔ matière (obligatoire pour collège/lycée).
// Au primaire, l'enseignant enseigne toutes les matières : pas de ligne ici.
model EnseignantMatiere {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere  @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([enseignantId, matiereId])
  @@index([tenantId])
  @@index([enseignantId])
  @@index([matiereId])
  @@map("enseignant_matieres")
}

// Affectation enseignant ↔ classe (+ matière optionnelle).
// Primaire : 1 ligne par enseignant, matiereId null (enseigne tout).
// Collège/Lycée : N lignes, matiereId obligatoire (une matière par classe).
model EnseignantAffectation {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  classeId String
  classe   Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)

  matiereId String? // null = primaire (toutes matières) ; requis pour collège/lycée
  matiere   Matiere? @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([enseignantId, classeId, matiereId])
  @@index([tenantId])
  @@index([enseignantId])
  @@index([classeId])
  @@index([matiereId])
  @@map("enseignant_affectations")
}

// ============================================================
// EMPLOI DU TEMPS
// ============================================================

enum Jour {
  DIMANCHE
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
}

model EmploiTemps {
  id       String @id @default(cuid())
  tenantId String

  classeId     String
  classe       Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiereId    String
  matiere      Matiere     @relation(fields: [matiereId], references: [id])
  enseignantId String?
  enseignant   Enseignant? @relation(fields: [enseignantId], references: [id])

  jour       Jour
  heureDebut String // "08:00"
  heureFin   String // "09:00"
  salle      String?
  annee      String

  @@index([tenantId])
  @@index([classeId])
  @@index([matiereId])
  @@index([enseignantId])
  @@map("emplois_temps")

  // Back-relation : séances du cahier de texte générées depuis ce créneau
  cahierTextes CahierTexte[]
}

model DisponibiliteEnseignant {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId       String?    // null = disponibilité sur tous les sites
  site         Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  jour         Jour
  heureDebut   String // "08:00"
  heureFin     String // "12:00"

  @@index([tenantId])
  @@index([siteId])
  @@index([enseignantId])
  @@map("disponibilites_enseignants")
}

// Indisponibilités d'un enseignant : créneaux à ÉVITER lors de la génération
// ou suggestion d'emploi du temps (autre établissement, rendez-vous, jour off…).
// Une journée entière = 00:00 → 23:59. Importable via CSV/Excel depuis les
// paramètres (source = "IMPORT") ou saisie manuelle (source = "MANUEL").
model IndisponibiliteEnseignant {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId       String?    // null = indisponibilité sur tous les sites
  site         Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  jour         Jour
  heureDebut   String // "08:00"
  heureFin     String // "12:00"
  source       String   @default("MANUEL") // MANUEL | IMPORT
  note         String?  // libellé optionnel (ex: "Autre établissement")
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([siteId])
  @@index([enseignantId])
  @@map("indisponibilites_enseignants")
}

model Salle {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  nom      String // "Salle 101"
  capacite Int     @default(30)
  type     String? // "cours", "labo", "informatique"
  batiment String?

  @@index([tenantId])
  @@index([siteId])
  @@map("salles")
}

// ============================================================
// ABSENCES
// ============================================================

enum MotifAbsence {
  INJUSTIFIE
  MALADIE
  FAMILIALE
  TRANSPORT
  AUTRE
}

enum StatutAbsence {
  EN_ATTENTE
  JUSTIFIEE
  INJUSTIFIEE
}

model Absence {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  date       DateTime
  heureDebut String? // null = journée entière
  heureFin   String?
  isRetard   Boolean  @default(false)

  motif        MotifAbsence  @default(INJUSTIFIE)
  statut       StatutAbsence @default(EN_ATTENTE)
  justificatif String? // URL document
  commentaire  String?

  saisieParId String? // userId enseignant

  // Notification parents
  parentNotifie   Boolean   @default(false)
  parentNotifieAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eleveId])
  @@index([tenantId, date])
  @@map("absences")
}

// ============================================================
// NOTES & ÉVALUATIONS
// ============================================================

enum TypeNote {
  CONTROLE
  DEVOIR
  EXAMEN
  INTERROGATION
  PROJET
  ORAL
  TP
}

model Evaluation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  titre String // "Controle 1 math test"
  type  TypeNote @default(CONTROLE)

  classeId  String
  classe    Classe  @relation(fields: [classeId], references: [id])
  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id])
  periodeId String
  periode   Periode @relation(fields: [periodeId], references: [id])

  date        DateTime
  duree       Int // en minutes
  coefficient Float    @default(1)
  description String?
  statut      String   @default("PLANIFIE") // PLANIFIE, TERMINE

  notes Note[]
  devoirs Devoir[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([classeId])
  @@index([matiereId])
  @@index([periodeId])
  @@map("evaluations")
}

model Note {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eleveId   String
  eleve     Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classeId  String
  classe    Classe   @relation(fields: [classeId], references: [id])
  matiereId String
  matiere   Matiere  @relation(fields: [matiereId], references: [id])
  periodeId String?
  periode   Periode? @relation(fields: [periodeId], references: [id])

  type        TypeNote @default(CONTROLE)
  intitule    String? // "DS n°1", "Examen semestriel"
  valeur      Float
  noteMax     Float    @default(20)
  coefficient Float    @default(1)
  date        DateTime

  appreciation String?
  commentaire  String? // Commentaire spécifique de l'évaluation
  saisieParId  String? // userId enseignant
  isPubliee    Boolean @default(false)

  evaluationId String?
  evaluation   Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eleveId])
  @@index([classeId])
  @@index([matiereId])
  @@index([periodeId])
  @@index([evaluationId])
  @@map("notes")
}

// ============================================================
// BULLETINS
// ============================================================

model Bulletin {
  id       String @id @default(cuid())
  tenantId String

  eleveId   String
  eleve     Eleve   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  periodeId String
  periode   Periode @relation(fields: [periodeId], references: [id])

  moyenneGenerale Float?
  moyenneClasse   Float?
  moyennePremier  Float?
  heuresAbsence   Int?   @default(0)

  rang           Int?
  effectifClasse Int?
  appreciation   String?
  decision       String? // "Passage", "Redoublement", "Félicitations"

  isPublie    Boolean   @default(false)
  publishedAt DateTime?
  pdfUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matieres BulletinMatiere[]

  @@unique([eleveId, periodeId])
  @@index([tenantId])
  @@index([periodeId])
  @@map("bulletins")
}

model BulletinMatiere {
  id       String @id @default(cuid())
  tenantId String

  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id])

  nomProfesseur String?

  coefficient  Float
  moyenneEleve Float?
  rang         Int?
  moyenneMax   Float?
  moyenneMin   Float?

  appreciation String?

  @@index([tenantId])
  @@index([bulletinId])
  @@index([matiereId])
  @@map("bulletin_matieres")
}

// ============================================================
// EXAMENS
// ============================================================

enum StatutExamen {
  PROGRAMME
  EN_COURS
  TERMINE
  ANNULE
}

model Examen {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  intitule    String // "Baccalauréat 2026"
  description String?
  statut      StatutExamen @default(PROGRAMME)
  dateDebut   DateTime
  dateFin     DateTime

  sessions SessionExamen[]

  @@index([tenantId])
  @@index([siteId])
  @@map("examens")
}

model SessionExamen {
  id     String @id @default(cuid())
  examId String
  examen Examen @relation(fields: [examId], references: [id], onDelete: Cascade)

  matiereNom   String
  date         DateTime
  heureDebut   String
  heureFin     String
  salle        String?
  surveillants Json? // array of user IDs
  niveau       String?

  // Lien direct classe + matière pour filtrage enseignant
  classeId String?
  classe   Classe? @relation(fields: [classeId], references: [id], onDelete: SetNull)
  matiereId String?
  matiere   Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  @@index([examId])
  @@index([classeId])
  @@index([matiereId])
  @@map("sessions_examen")
}

// ============================================================
// FACTURATION
// ============================================================

enum StatutFacture {
  EN_ATTENTE
  PAYEE
  EN_RETARD
  ANNULEE
}

model Facture {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // eleveId est optionnel : une facture d'admission est créée avant l'élève.
  // Quand l'élève est créé (INSCRIT), on relie la facture à l'élève.
  eleveId String?
  eleve   Eleve?  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  // Lien optionnel vers la candidature (facture d'inscription/admission)
  candidatureId String?
  candidature   Candidature? @relation(fields: [candidatureId], references: [id], onDelete: SetNull)

  numero   String
  libelle  String // "Scolarité 2025-2026", "Cantine Octobre"
  montant  Float
  devise   String        @default("DJF")
  statut   StatutFacture @default(EN_ATTENTE)
  echeance DateTime?
  mois     String? // "2025-10" pour le classement mensuel des factures

  paiements Paiement[]
  relances  Relance[]

  createdById String? // User who created the invoice
  createdBy   User?   @relation("FactureCreePar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eleveId])
  @@index([candidatureId])
  @@index([tenantId, statut])
  @@index([tenantId, mois])
  @@index([siteId])
  @@map("factures")
}

model Paiement {
  id        String  @id @default(cuid())
  factureId String
  facture   Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  montant   Float
  devise    String   @default("DJF")
  methode   String // "espèces", "waffi", "cac_pay", "dahab_plus", "saba_pay", "faida", "virement"
  reference String?
  date      DateTime @default(now())
  recu      String? // URL reçu PDF

  enregistreParId String? // User who recorded the payment
  enregistrePar   User?   @relation("PaiementEnregistrePar", fields: [enregistreParId], references: [id], onDelete: SetNull)

  // Suivi du dépôt du cash à la banque
  depotBanque    String?
  depotDate      DateTime?
  depotParId     String?
  depotPar       User? @relation("PaiementDeposePar", fields: [depotParId], references: [id], onDelete: SetNull)

  // Récupération par le directeur
  directorRecu   Boolean  @default(false)
  directorRecuAt DateTime?
  directorRecuParId String?
  directorRecuPar   User? @relation("PaiementDirectorRecuPar", fields: [directorRecuParId], references: [id], onDelete: SetNull)

  @@index([factureId])
  @@index([depotParId])
  @@index([directorRecuParId])
  @@map("paiements")
}

model Depense {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId      String?
  site        Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  categorie   String
  description String?
  fournisseur String?
  justificatif String?
  montant     Float
  devise      String  @default("DJF")
  date        DateTime @default(now())

  // Traçabilité de l'engagement de dépense
  typeEngagement String? // "bon_commande", "facture", "bon_livraison", "achat_comptant"
  autoriseParId String?
  autorisePar   User?   @relation("DepenseAutorisePar", fields: [autoriseParId], references: [id], onDelete: SetNull)
  payeParId     String?
  payePar       User?   @relation("DepensePayePar", fields: [payeParId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("DepenseCreePar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([date])
  @@map("depenses")
}

model Budget {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId        String?
  site          Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  categorie     String
  periode       String  // ex: "2025-09" ou "2025-S1"
  montantPrevu  Float

  createdById   String?
  createdBy     User?   @relation("BudgetCreePar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, siteId, categorie, periode])
  @@index([tenantId])
  @@index([siteId])
  @@map("budgets")
}

// ============================================================
// REMISE DE CAISSE (handover of cash from cashier to recipient)
// ============================================================

enum StatutRemise {
  EN_ATTENTE
  CONFIRME
  REJETE
}

model RemiseCaisse {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId      String?
  site        Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // Déclaration du caissier
  caissierId      String
  caissier        User    @relation("RemiseCaissier", fields: [caissierId], references: [id], onDelete: Cascade)
  montantDeclare  Float
  dateDeclaration DateTime @default(now())

  // Destinataire prévu (ex: directeur, comptable)
  destinataireId  String?
  destinataire    User?   @relation("RemiseDestinataire", fields: [destinataireId], references: [id], onDelete: SetNull)

  // Confirmation par le destinataire
  montantRecu     Float?
  dateReception   DateTime?
  recuParId       String?
  recuPar         User?   @relation("RemiseRecuePar", fields: [recuParId], references: [id], onDelete: SetNull)

  statut          StatutRemise @default(EN_ATTENTE)

  // Liste des paiements inclus dans cette remise (JSON array of paiement IDs)
  paiementIds     String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([caissierId])
  @@index([statut])
  @@map("remises_caisse")
}

// ============================================================
// TARIFICATION PAR NIVEAU
// ============================================================

model TarifNiveau {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  niveau         String  // "Maternelle", "Primaire", "Collège", "Lycée"
  annee          String  // "2025-2026"
  mensualite     Float   // montant mensuel scolarité
  fraisInscription Float // première inscription
  fraisRenouvellement Float // renouvellement annuel
  fraisCantine   Float?  // par mois (optionnel)
  fraisTransport Float?  // par mois (optionnel)
  devise         String  @default("DJF")
  nbMois         Int     @default(10) // nombre de mensualités par an
  actif          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, niveau, annee, siteId])
  @@index([tenantId])
  @@index([siteId])
  @@map("tarifs_niveau")
}

// ============================================================
// RELANCES (après retard de paiement)
// ============================================================

model Relance {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  factureId String
  facture   Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  niveau    Int     // 1 = première relance, 2 = deuxième, 3 = troisième
  canal     String  // "sms", "whatsapp", "email", "courrier"
  message   String
  envoyeeParId String?
  envoyeePar   User?   @relation("RelanceEnvoyeePar", fields: [envoyeeParId], references: [id], onDelete: SetNull)

  envoyeeLe DateTime @default(now())

  @@index([tenantId])
  @@index([factureId])
  @@map("relances")
}

// ============================================================
// EXCLUSION D'ÉLÈVE (pour non-paiement)
// ============================================================

model ExclusionEleve {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eleveId   String
  eleve     Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  motif     String  // "NON_PAIEMENT", "NON_PAIEMENT_REPETE"
  details   String?
  dateDebut DateTime
  dateFin   DateTime? // null = exclusion en cours
  leveeParId String?
  leveePar   User?   @relation("ExclusionLeveePar", fields: [leveeParId], references: [id], onDelete: SetNull)
  leveeLe    DateTime?

  decideeParId String?
  decideePar   User?   @relation("ExclusionDecideePar", fields: [decideeParId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([eleveId])
  @@map("exclusions_eleve")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id       String  @id @default(cuid())
  tenantId String
  eleveId  String?
  eleve    Eleve?  @relation(fields: [eleveId], references: [id])

  nom      String
  type     String // "acte_naissance", "photo", "justificatif", etc.
  url      String
  taille   Int? // bytes
  mimeType String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([eleveId])
  @@map("documents")
}

// ============================================================
// ÉVÉNEMENTS / AGENDA
// ============================================================

model Evenement {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = événement global (tous sites)
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  titre       String
  description String?
  type        String // "reunion", "sortie", "vacances", "conseil_classe"
  dateDebut   DateTime
  dateFin     DateTime?
  lieu        String?
  couleur     String?

  cible String @default("all") // "all", classe ID, niveau

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([siteId])
  @@map("evenements")
}

// ============================================================
// VIE SCOLAIRE & DISCIPLINE
// ============================================================

enum TypeIncident {
  RETARD
  BAVARDAGE
  INSOLENCE
  BAGARRE
  TRICHE
  VANDALISM
  ABSENTEISME
  AUTRE
}

enum StatutIncident {
  OUVERT
  EN_TRAITEMENT
  RESOLU
  CLASSE
}

enum TypeSanction {
  AVERTISSEMENT
  BLAME
  EXCLUSION_COURS
  EXCLUSION_TEMP
  CONVOCATION_PARENTS
  TRAVAUX_INTERET_GENERAL
  AUTRE
}

model Incident {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  rapporteParId String?
  rapportePar   User?   @relation("IncidentReporter", fields: [rapporteParId], references: [id])

