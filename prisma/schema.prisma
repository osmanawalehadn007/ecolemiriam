// ============================================================
// AUDIT & TRAÇABILITÉ
// ============================================================

enum AuditVerdict {
  ALLOWED
  DENIED
}

// ============================================================
// CAHIER DE TEXTE — registre des séances de cours
// ============================================================
// L'enseignant y inscrit ce qui a été fait à chaque séance,
// les devoirs donnés et ce qui est prévu pour le cours suivant.
// Le conseiller (CPE) et la direction peuvent consulter.

// Workflow d'une séance :
//   PLANIFIEE  → créée depuis l'emploi du temps, pas encore renseignée
//   EFFECTUEE  → l'enseignant a rempli le contenu (défaut pour saisie manuelle)
//   CLOTUREE   → validée par l'enseignant ou la direction
//   ANNULEE    → cours annulé (prof absent, grève, etc.)
//   REMPLACEE  → remplacée par une autre séance (lien via seanceRemplacementId)
enum StatutSeance {
  PLANIFIEE
  EFFECTUEE
  CLOTUREE
  ANNULEE
  REMPLACEE
}

model CahierTexte {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  classeId    String
  classe      Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiereId   String
  matiere     Matiere     @relation(fields: [matiereId], references: [id])
  enseignantId String?
  enseignant   Enseignant? @relation(fields: [enseignantId], references: [id])

  // Lien optionnel vers l'emploi du temps (séance auto-générée)
  emploiTempsId String?
  emploiTemps   EmploiTemps? @relation(fields: [emploiTempsId], references: [id], onDelete: SetNull)

  // Lien optionnel vers un chapitre du programme
  chapitreId String?
  chapitre   Chapitre?   @relation(fields: [chapitreId], references: [id], onDelete: SetNull)

  date       DateTime  // date de la séance
  heureDebut String?   // "08:00"
  heureFin   String?   // "09:00"

  // Statut de la séance (workflow)
  statut      StatutSeance @default(EFFECTUEE)

  contenu      String  @db.Text // ce qui a été fait en classe
  devoirs      String? @db.Text // devoirs / travail à faire à la maison (legacy — préférer le modèle Devoir)
  prochainCours String? @db.Text // prévision pour la séance suivante
  commentaire  String? @db.Text // remarques libres de l'enseignant

  // Contenu structuré (JSON)
  // objectifs: String[] — objectifs pédagogiques de la séance
  // activites: [{ type: "COURS"|"EXERCICE"|"TP"|"EVALUATION"|"PROJET", description: string, dureeMin?: number }]
  // supports: [{ type: "DOCUMENT"|"VIDEO"|"LIEN"|"COURS_EN_LIGNE", url: string, coursId?: string }]
  // differentiation?: string — adaptations pour élèves à besoins spécifiques
  contenuStructure  Json?

  // Fichiers attachés (JSON array: [{nom, type, taille, dataUrl}])
  // .doc, .docx, .pdf, .odt — stockés en base64 data URL
  fichiers     Json?

  saisieParId String? // userId de l'enseignant qui a saisi
  saisiePar   User?   @relation("CahierTexteSaisiePar", fields: [saisieParId], references: [id], onDelete: SetNull)

  // Horodatage des transitions de statut
  effectueeAt   DateTime? // quand la séance a été renseignée
  clotureeAt    DateTime? // quand la séance a été clôturée

  // Commentaires (CPE / conseiller / direction)
  commentaires CahierTexteCommentaire[]

  // Devoirs liés à cette séance
  devoirsLiees Devoir[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([classeId])
  @@index([matiereId])
  @@index([enseignantId])
  @@index([emploiTempsId])
  @@index([chapitreId])
  @@index([statut])
  @@index([tenantId, date])
  @@map("cahier_textes")
}

// ============================================================
// COMMENTAIRES DU CAHIER DE TEXTE
// ============================================================
// Le conseiller (CPE), la direction ou tout rôle avec cahier-texte:read
// peut ajouter des commentaires sur une séance — feedback pédagogique,
// remarque de conformité, etc.

model CahierTexteCommentaire {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cahierTexteId String
  cahierTexte   CahierTexte @relation(fields: [cahierTexteId], references: [id], onDelete: Cascade)

  auteurId   String
  auteur     User   @relation("CahierTexteCommentaireAuteur", fields: [auteurId], references: [id], onDelete: Cascade)

  contenu    String  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([cahierTexteId])
  @@index([auteurId])
  @@map("cahier_texte_commentaires")
}

model AuditLog {
  id         String       @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  verdict    AuditVerdict
  resource   String?
  resourceId String?
  reason     String?
  metadata   Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([verdict])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// FOURNITURES SCOLAIRES
// ============================================================
// Flux : enseignant → secrétariat → publication → parents/élèves
// L'enseignant saisit par niveau (ex: "6ème") pour sa matière.
// Le secrétariat compile, complète et valide avant publication.

enum FournitureType {
  LIVRE
  CAHIER
  INSTRUMENT
  AUTRE
}

enum FournitureStatut {
  BROUILLON  // Saisie en cours par l'enseignant
  SOUMISE    // Soumise au secrétariat pour validation
  VALIDEE    // Validée par le secrétariat
  PUBLIEE    // Publiée — visible par les parents/élèves
  REJETEE    // Rejetée par le secrétariat
}

model FournitureListe {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = tous les sites
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  niveau    String  // "6ème", "CM2" — correspond à Classe.niveau
  annee     String  // "2025-2026"
  matiereId String? // null = fournitures générales (ajoutées par le secrétariat)
  matiere   Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  statut FournitureStatut @default(BROUILLON)

  // Enseignant qui a créé/soumis cette liste
  enseignantId String?
  enseignant   Enseignant? @relation(fields: [enseignantId], references: [id], onDelete: SetNull)

  // Validation par le secrétariat
  valideeParId String?
  valideePar   User? @relation("FournitureValideePar", fields: [valideeParId], references: [id], onDelete: SetNull)
  valideeAt    DateTime?
  publieeAt    DateTime?

  commentaireEnseignant  String? // Notes de l'enseignant
  commentaireSecretariat String? // Notes du secrétariat

  items FournitureItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, niveau, annee, matiereId]) // Une seule liste par niveau/année/matière
  @@index([tenantId])
  @@index([siteId])
  @@index([matiereId])
  @@index([enseignantId])
  @@index([statut])
  @@map("fourniture_listes")
}

model FournitureItem {
  id      String @id @default(cuid())
  listeId String
  liste   FournitureListe @relation(fields: [listeId], references: [id], onDelete: Cascade)

  nom         String        // "Cahier 200 pages"
  type        FournitureType
  quantite    Int           @default(1)
  format      String?       // "A4", "17x22", "192 pages"
  description String?
  marque      String?       // Pour les livres : éditeur/auteur

  ordre Int @default(0) // Ordre d'affichage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listeId])
  @@map("fourniture_items")
}

// ============================================================
// DEVOIRS — travail à faire à la maison, lié à une séance
// ============================================================
// Remplace le champ texte libre `devoirs` sur CahierTexte par un
// objet traçable avec date de remise, type, et suivi des rendus.
// Les élèves/parents voient les devoirs sur l'app mobile.

enum TypeDevoir {
  EXERCICE
  LECTURE
  RECHERCHE
  REVISION
  PROJET
  DISSERTATION
  AUTRE
}

enum StatutDevoir {
  DONNE       // devoir donné, en attente de remise
  RENDU       // élève a rendu le devoir
  NON_RENDU   // date de remise dépassée sans rendu
  CORRIGE     // corrigé par l'enseignant
}

model Devoir {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // Séance qui a donné le devoir
  seanceId   String
  seance     CahierTexte @relation(fields: [seanceId], references: [id], onDelete: Cascade)

  classeId  String
  classe    Classe  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id])

  description  String  @db.Text
  type         TypeDevoir @default(EXERCICE)
  dateRemise   DateTime  // échéance
  statut       StatutDevoir @default(DONNE)

  // Lien optionnel vers une évaluation (si le devoir est noté)
  evaluationId String?
  evaluation   Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  // Fichiers attachés (consigne, sujet)
  fichiers Json?

  donneParId String?
  donnePar   User?   @relation("DevoirDonnePar", fields: [donneParId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([seanceId])
  @@index([classeId])
  @@index([matiereId])
  @@index([statut])
  @@index([dateRemise])
  @@map("devoirs")
}

// ============================================================
// CHAPITRES — progression du programme par matière/classe
// ============================================================
// Permet de suivre l'avancement du programme : chaque chapitre
// a un nombre d'heures prévues, et les séances rattachées
// permettent de calculer le % réalisé.

model Chapitre {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id])

  // Cible : niveau (ex: "6ème") ou classe spécifique
  niveau  String?  // "6eme", "Terminale S", etc.
  classeId String?
  classe   Classe?  @relation(fields: [classeId], references: [id], onDelete: SetNull)

  titre       String  // "Calcul différentiel"
  description String? @db.Text
  ordre       Int     @default(0) // ordre dans le programme
  nbHeuresPrevues Int  @default(0) // durée estimée en heures

  // Période (trimestre/semestre)
  periodeId String?
  periode   Periode? @relation(fields: [periodeId], references: [id], onDelete: SetNull)

  // Séances rattachées à ce chapitre
  seances CahierTexte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([matiereId])
  @@index([classeId])
  @@index([periodeId])
  @@map("chapitres")
}
