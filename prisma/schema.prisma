  DOSSIER_COMPLET // Pièces justificatives reçues et vérifiées
  EN_EXAMEN // Dossier en cours d'examen
  ADMIS // Candidat admis
  REFUSE // Candidature refusée
  INSCRIT // Passage en inscription confirmée
  ANNULE // Candidature annulée
}

model Candidature {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = candidature non rattachée à un site
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // Informations élève
  nom           String
  prenom        String
  dateNaissance DateTime
  lieuNaissance String?
  sexe          Sexe     @default(M)
