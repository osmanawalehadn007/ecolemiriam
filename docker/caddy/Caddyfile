# ============================================================
# École Miriam — Caddyfile (reverse proxy + TLS interne + sécurité)
# ============================================================
# Caddy reçoit le trafic depuis cloudflared (port 8080 interne).
# TLS interne (self-signed), Cloudflare termine le TLS externe.
# Headers de sécurité, rate limiting, proxy vers l'app.
#
# Blue-Green : l'upstream est défini dans upstream.conf (import).
# Le script blue-green-deploy.sh switche entre app-blue et app-green
# en réécrivant upstream.conf + caddy reload (zero downtime).
# ============================================================

{
	# Désactiver le HTTPS public (Cloudflare gère le TLS externe)
	auto_https off
	email admin@ecolemiriam.com
}

# ============================================================
# Proxy principal : app.ecolemiriam.com
# ============================================================
:8080 {
	# TLS interne (certificat self-signed, Cloudflare termine le TLS externe)
	tls internal {
		protocols tls1.3
	}

	# --- Headers de sécurité ---
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-DNS-Prefetch-Control "on"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://api.africastalking.com https://api.resend.com https://graph.facebook.com https://api.telegram.org https://api.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Cache des assets statiques Next.js
		/.next/static/* {
			Cache-Control "public, max-age=31536000, immutable"
		}
	}

	# --- Rate limiting ---
	# Login : 5 tentatives / minute / IP
	@api_auth {
		path /api/auth/*
	}
	handle @api_auth {
		rate_limit {
			zone auth {
				key {remote_host}
				events 5
				window 1m
			}
		}
		# Upstream swappable (blue-green) — voir upstream-simple.conf
		import upstream-simple.conf
	}

	# Cron : 10 appels / minute (Ofelia appelle en interne)
	@api_cron {
		path /api/cron/*
	}
	handle @api_cron {
		rate_limit {
			zone cron {
				key {remote_host}
				events 10
				window 1m
			}
		}
		import upstream-simple.conf
	}

	# Uploads : 10 / minute / IP
	@api_upload {
		path /api/eleves/upload-photo /api/parametres/upload-signature
	}
	handle @api_upload {
		rate_limit {
			zone upload {
				key {remote_host}
				events 10
				window 1m
			}
		}
		import upstream-simple.conf
	}

	# --- Route par défaut ---
	# Upstream swappable (blue-green) — voir upstream.conf
	# Contient le bloc reverse_proxy complet avec health checks + headers
	handle {
		import upstream.conf
	}

	# --- Health endpoint pour Caddy lui-même ---
	handle /health {
		respond "OK" 200
	}

	# --- Logging ---
	log {
		output stdout
		format json
		level info
	}

	# --- Compression ---
	encode gzip zstd
}

# ============================================================
# Monitoring : status.ecolemiriam.com (Uptime Kuma)
# ============================================================
:8081 {
	tls internal {
		protocols tls1.3
	}
	reverse_proxy monitoring:3001
}
