{
  "name": "EcolPro Monitoring",
  "description": "Configuration Uptime Kuma pour EcolPro VPS",
  "monitors": [
    {
      "name": "App Health",
      "type": "http",
      "url": "https://app.ecloemiriam.com/api/health",
      "interval": 60,
      "timeout": 10,
      "retryInterval": 30,
      "maxretries": 3,
      "notification": {
        "type": "telegram",
        "botToken": "${TELEGRAM_BOT_TOKEN}",
        "chatID": "${TELEGRAM_CHAT_ID}",
        "message": "🔴 App EcolPro DOWN — {{ msg }}"
      }
    },
    {
      "name": "Postgres Health",
      "type": "tcp",
      "hostname": "postgres",
      "port": 5432,
      "interval": 60,
      "notification": {
        "type": "telegram",
        "message": "🔴 Postgres EcolPro DOWN"
      }
    },
    {
      "name": "Cloudflare Tunnel",
      "type": "http",
      "url": "https://app.ecloemiriam.com",
      "interval": 120,
      "timeout": 15,
      "notification": {
        "type": "telegram",
        "message": "🔴 Cloudflare Tunnel EcolPro DOWN"
      }
    },
    {
      "name": "pgBackRest Backup",
      "type": "push",
      "interval": 86400,
      "notification": {
        "type": "telegram",
        "message": "🔴 pgBackRest backup EcolPro manquant depuis 24h"
      }
    }
  ],
  "notifications": [
    {
      "name": "Telegram Admin",
      "type": "telegram",
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "chatID": "${TELEGRAM_CHAT_ID}",
      "isDefault": true
    }
  ]
}
