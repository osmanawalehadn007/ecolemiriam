# ============================================================
# École Miriam — Configuration Cloudflare API
# ============================================================
# Copier ce fichier en .cf-token.env et remplir les valeurs.
# NE JAMAIS committer .cf-token.env (déjà dans .gitignore).
# ============================================================

# --- Token API Cloudflare ---
# Créer sur : https://dash.cloudflare.com/profile/api-tokens
# Permissions requises :
#   Zone:Read, Zone:Edit, DNS:Edit, SSL:Edit, WAF:Edit
# Zone Resources : Include → Specific zone → ecolemiriam.com
CF_API_TOKEN=

# --- Domaine principal ---
CF_DOMAIN=ecolemiriam.com

# --- Zone ID ---
# Auto-détecté si vide. Sinon, trouver sur :
# https://dash.cloudflare.com → ecolemiriam.com → Overview (bottom right)
CF_ZONE_ID=

# --- Account ID ---
# Auto-détecté si vide. Sinon, trouver sur :
# https://dash.cloudflare.com → Account Home (sidebar, bottom)
CF_ACCOUNT_ID=

# --- Tunnel ID ---
# Trouver sur : https://one.dash.cloudflare.com → Networks → Tunnels
# Sélectionner le tunnel → copier l'ID dans l'URL
CF_TUNNEL_ID=
