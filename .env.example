# ============================================================
# ECOLEMIRIAM — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=École Miriam
NODE_ENV=development

# --- Cloudflare API (configuration du domaine via API) ---
# Token API Cloudflare pour automatiser la configuration (DNS, SSL, WAF)
# Créer sur : https://dash.cloudflare.com/profile/api-tokens
# Permissions requises : Zone:Read, Zone:Edit, DNS:Edit, SSL:Edit, WAF:Edit
CF_API_TOKEN=
# Domaine principal sur Cloudflare
CF_DOMAIN=ecolemiriam.com
# Zone ID (auto-détecté si vide) — https://dash.cloudflare.com → ecolemiriam.com
CF_ZONE_ID=
# Account ID (auto-détecté si vide)
CF_ACCOUNT_ID=
# Tunnel ID — https://one.dash.cloudflare.com → Networks → Tunnels
CF_TUNNEL_ID=

# --- Base de données PostgreSQL ---
#
# PRODUCTION VPS (docker-compose) — l'app parle a PgBouncer, jamais a Postgres
# directement. PgBouncer ecoute sur le port 6432 en mode transaction, d'ou le
# parametre `pgbouncer=true` (sans lui, Prisma emet des prepared statements que
# PgBouncer ne peut pas conserver : erreurs « prepared statement s0 already
# exists » intermittentes).
#   DATABASE_URL="postgresql://ecolemiriam_app:MDP@pgbouncer:6432/ecolemiriam?pgbouncer=true&connection_limit=1"
#
# DIRECT_URL est OBLIGATOIRE : prisma/schema.prisma ligne 13 le declare
# (`directUrl = env("DIRECT_URL")`). Il doit contourner PgBouncer et viser
# Postgres en direct, sinon `prisma migrate` echoue.
#   DIRECT_URL="postgresql://ecolemiriam_app:MDP@postgres:5432/ecolemiriam"
#
# DEVELOPPEMENT LOCAL :
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecolemiriam?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/ecolemiriam?schema=public"

# --- NextAuth / Auth.js ---
AUTH_SECRET="votre-secret-tres-long-et-aleatoire-ici"   # openssl rand -base64 32

# AUTH_URL est la SOURCE DE VERITE unique de l'adresse publique. Elle pilote :
#   - les callbacks et redirections Auth.js
#   - le prefixe des cookies de session (__Secure- si et seulement si https://)
#   - les origines acceptees par la protection CSRF (src/lib/security/csrf.ts)
# En production : AUTH_URL=https://ecolemiriam.com (apex, seul domaine servi)
AUTH_URL=http://localhost:3000

# Derriere Cloudflare Tunnel -> Caddy -> app, la requete arrive en HTTP interne.
# Sans cette variable (ou `trustHost: true`, deja pose dans src/auth.config.ts),
# Auth.js v5 rejette l'en-tete Host du proxy avec l'erreur UntrustedHost et
# /api/auth/* repond 500.
AUTH_TRUST_HOST=true

# Alias historiques encore lus par Auth.js (src/auth.config.ts) et par l'auth
# mobile (/api/auth/mobile, src/lib/mobile-auth.ts). En production, ils doivent
# valoir exactement AUTH_URL et AUTH_SECRET.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Origines supplementaires acceptees par la verification CSRF, separees par des
# virgules. Utile si le domaine apex sert aussi l'app, ou pour une recette.
# Ex: EXTRA_ALLOWED_ORIGINS=https://ecolemiriam.com,https://staging.ecolemiriam.com
EXTRA_ALLOWED_ORIGINS=

# --- OAuth (optionnel) ---
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="École Miriam <noreply@ecolemiriam.com>"
# Signature Svix du webhook /api/webhooks/resend (dashboard Resend → Webhooks).
# Sans elle, la signature n'est pas vérifiée (simple avertissement en log).
RESEND_WEBHOOK_SECRET=
# Destinataire par défaut de scripts/test-email-delivery.ts (sinon adresse en dur).
TEST_EMAIL_TO=

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Redis auto-hébergé (ioredis) ---
# Cache et verrous côté serveur (src/lib/redis.ts). En production, l'absence de
# cette variable est journalisée comme une erreur et le cache est désactivé.
# Ex : REDIS_URL=redis://:motdepasse@redis:6379/0
REDIS_URL=

# --- Stockage fichiers (Cloudflare R2 / AWS S3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ecolemiriam-files
NEXT_PUBLIC_R2_PUBLIC_URL=https://files.ecolemiriam.com

# --- Paiements (Stripe) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Push Notifications (Firebase Cloud Messaging, API HTTP v1) ---
# Coller le JSON complet du compte de service Firebase (ou sa version base64).
# Couvre Android (FCM) et iOS (APNs via FCM).
FCM_SERVICE_ACCOUNT=

# --- SMS (Africa's Talking) ---
# Docs: https://developers.africastalking.com/docs/sms
# 1. Créer un compte sur https://africastalking.com
# 2. Récupérer API Key et Username dans le dashboard
# 3. En sandbox, utiliser un numéro de test
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=École Miriam

# --- WhatsApp Business Cloud API ---
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api
# 1. Créer une app sur https://developers.facebook.com → WhatsApp Business
# 2. Ajouter le produit "WhatsApp" à l'app
# 3. Récupérer le token d'accès permanent et le Phone Number ID
# 4. Pour les tests: utiliser le numéro de test fourni par Meta
# Token d'accès permanent (commence par EAAB...)
WHATSAPP_API_TOKEN=
# ID du numéro WhatsApp Business (visible dans le dashboard Meta)
WHATSAPP_PHONE_NUMBER_ID=
# ID du compte business (optionnel)
WHATSAPP_BUSINESS_ID=

# --- Telegram Bot API ---
# Docs: https://core.telegram.org/bots/api
# 1. Ouvrir Telegram et chercher @BotFather
# 2. Envoyer /newbot et suivre les instructions
# 3. Copier le token fourni par BotFather
# 4. Pour trouver votre chat_id: envoyez /start au bot, puis
#    appelez GET /api/test/telegram?step=chatid
TELEGRAM_BOT_TOKEN=

# --- Mobile (Capacitor) ---
# URL de production vers laquelle pointe la coque native iOS/Android.
CAP_SERVER_URL=https://ecolemiriam.com

# --- App mobile Expo (dossier mobile-app/) ---
# URL de l'API consommée par l'app Expo (EXPO_PUBLIC_ présente la valeur au client).
EXPO_PUBLIC_API_URL=

# --- Tests E2E (Playwright) ---
# Si défini, la suite cible cette URL déjà déployée et ne démarre AUCUN serveur
# local (playwright.config.ts). Vide : serveur local sur le port 3001.
PLAYWRIGHT_BASE_URL=

# --- Cron (notifications planifiées) ---
# Secret protégeant /api/cron/*. L'ordonnanceur du conteneur GCP (systemd ou
# crontab de l'hôte, voir docker/) doit envoyer lui-même :
#   Authorization: Bearer <CRON_SECRET>
# Générer : openssl rand -hex 32
CRON_SECRET=

# --- Webhooks entrants (sécurité) ---
# WhatsApp/Meta : App Secret pour vérifier la signature x-hub-signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=ecolemiriam_whatsapp_token
# Africa's Talking n'a pas de signature : protéger via un secret partagé.
# Configurer l'URL de callback avec ?secret=<valeur>. Générer : openssl rand -hex 16
WEBHOOK_SMS_SECRET=

# --- Assistant IA (GLM via OpenRouter) ---
# Docs OpenRouter: https://openrouter.ai/docs
# 1. Créer un compte sur https://openrouter.ai et générer une clé API
# 2. Renseigner ici l'identifiant exact du modèle GLM tel qu'affiché sur
#    https://openrouter.ai/models (ex: "z-ai/glm-4.6"). Sans valeur, l'assistant
#    IA est désactivé et renvoie une erreur de configuration explicite.
GLM_API_KEY=
GLM_API_BASE_URL=https://openrouter.ai/api/v1
GLM_MODEL=

# --- Cron (purge automatique des sites supprimés) ---
# Générer: openssl rand -hex 16
# Appeler quotidiennement: GET /api/cron/purge-sites avec Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- RLS (Row Level Security) ---
# Mettre "true" pour activer l'isolation RLS au niveau base.
# Nécessite : migration_rls_hardening.sql exécutée + rôle ecolemiriam_app.
# DATABASE_URL doit pointer vers le rôle ecolemiriam_app (NOBYPASSRLS).
RLS_ACTIVE=

# --- Cloudflare Turnstile (anti-bot CAPTCHA) ---
# Widget créé sur https://dash.cloudflare.com → Turnstile
# Site key (publique, côté client) :
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret (privé, côté serveur) :
TURNSTILE_SECRET=
# Laisser vide en dev local pour désactiver la vérification (mode dégradé).

# --- Sauvegardes (pg_dump chiffré + upload off-site) ---
# Clé publique age pour le chiffrement (générer: age-keygen -o key.txt)
# La clé privée est stockée SÉPARÉMENT (jamais dans le repo).
BACKUP_AGE_KEY=
# Configuration rclone pour le remote de stockage (R2, S3, Backblaze…)
# Voir: rclone config
BACKUP_RCLONE_REMOTE=ecolemiriam-backup
# Rétention des backups off-site en jours
BACKUP_RETENTION_DAYS=30
