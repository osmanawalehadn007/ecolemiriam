# ============================================================
# ÉCOLE MIRIAM — .env.production (VPS Docker)
# ============================================================
# Copier en `.env.production` À LA RACINE du dépôt (docker-compose.yml y fait
# référence via `env_file: ../.env.production`). Ce fichier ne doit JAMAIS être
# commité — il est couvert par .gitignore.
#
#   cp .env.production.template .env.production && chmod 600 .env.production
# ============================================================

NODE_ENV=production

# --- Adresse publique : source de vérité unique ---
# Pilote les callbacks Auth.js, le préfixe des cookies (__Secure- car https)
# et les origines acceptées par la protection CSRF.
AUTH_URL=https://app.ecolemiriam.com
NEXT_PUBLIC_APP_URL=https://app.ecolemiriam.com
NEXT_PUBLIC_APP_NAME=École Miriam

# Obligatoire derrière Cloudflare Tunnel → Caddy → app (HTTP interne).
AUTH_TRUST_HOST=true

# Origines supplémentaires pour la vérification CSRF (séparées par virgule).
# Laisser vide si seul app.ecolemiriam.com sert l'application.
EXTRA_ALLOWED_ORIGINS=

# --- Secret de session ---
# À RÉGÉNÉRER : l'ancienne valeur a fuité dans .env.supabase-backup.
#   openssl rand -base64 32
AUTH_SECRET=

# --- Base de données ---
# L'app passe par PgBouncer (service `pgbouncer`, port 6432, mode transaction).
# `pgbouncer=true` est indispensable : sans lui Prisma émet des prepared
# statements que PgBouncer ne conserve pas → erreurs intermittentes
# « prepared statement s0 already exists ».
DATABASE_URL="postgresql://ecolemiriam_app:MOT_DE_PASSE@pgbouncer:6432/ecolemiriam?pgbouncer=true&connection_limit=1&connect_timeout=15"

# DIRECT_URL contourne PgBouncer (prisma/schema.prisma l.13 l'exige).
# Utilisé par prisma migrate / db push uniquement.
DIRECT_URL="postgresql://ecolemiriam_app:MOT_DE_PASSE@postgres:5432/ecolemiriam?connect_timeout=15"

# Le rôle ecolemiriam_app est NOBYPASSRLS : les policies RLS s'appliquent.
RLS_ACTIVE=true

# --- Cron ---
# openssl rand -hex 32
CRON_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="École Miriam <noreply@ecolemiriam.com>"

# --- Canaux de notification (optionnels) ---
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=EcolPro
WEBHOOK_SMS_SECRET=

# --- Assistant IA (optionnel) ---
GLM_API_KEY=
GLM_API_BASE_URL=https://openrouter.ai/api/v1
GLM_MODEL=

# --- Sauvegardes ---
BACKUP_AGE_KEY=
BACKUP_RCLONE_REMOTE=ecolemiriam-backup
BACKUP_RETENTION_DAYS=30

# ============================================================
# NE PAS AJOUTER ICI :
#   SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
#   → l'infrastructure est 100 % VPS, Supabase n'est plus utilisé.
# ============================================================
