# ============================================================
# ÉCOLE MIRIAM — .env.production (VPS Docker)
# ============================================================
# Copier en `.env.production` À LA RACINE du dépôt (docker-compose.yml y fait
# référence via `env_file: ../.env.production`). Ce fichier ne doit JAMAIS être
# commité — il est couvert par .gitignore.
#
#   cp .env.production.template .env.production && chmod 600 .env.production
# ============================================================

NODE_ENV=production

# --- Adresse publique : source de vérité unique ---
# Pilote les callbacks Auth.js, le préfixe des cookies (__Secure- car https)
# et les origines acceptées par la protection CSRF.
AUTH_URL=https://ecolemiriam.com
NEXT_PUBLIC_APP_URL=https://ecolemiriam.com
NEXT_PUBLIC_APP_NAME=École Miriam

# Obligatoire derrière Cloudflare Tunnel → Caddy → app (HTTP interne).
AUTH_TRUST_HOST=true

# Origines supplémentaires pour la vérification CSRF (séparées par virgule).
# Le domaine canonique est ecolemiriam.com, et c'est le seul.
# Vide : l'apex est le seul domaine servi, et il est déjà couvert par
# AUTH_URL. `app.ecolemiriam.com` ne renvoie plus qu'un 301, aucun POST
# ne peut donc en provenir — l'y autoriser n'ouvrirait qu'une surface CSRF.
EXTRA_ALLOWED_ORIGINS=

# --- Secret de session ---
# À RÉGÉNÉRER : l'ancienne valeur a fuité dans .env.supabase-backup.
#   openssl rand -base64 32
AUTH_SECRET=

# --- Base de données ---
# L'app passe par PgBouncer (service `pgbouncer`, port 6432, mode transaction).
# `pgbouncer=true` est indispensable : sans lui Prisma émet des prepared
# statements que PgBouncer ne conserve pas → erreurs intermittentes
# « prepared statement s0 already exists ».
#
# connection_limit=30 : 30 connexions TCP vers PgBouncer (calibré pour les
#   heures de pointe — début de journée, rentrée scolaire). PgBouncer
#   multiplexe vers default_pool_size=40 connexions serveur PG.
# pool_timeout=15 : attend jusqu'à 15s une connexion libre avant d'erreur.
# connect_timeout=15 : timeout de connexion TCP initial.
DATABASE_URL="postgresql://ecolemiriam_app:MOT_DE_PASSE@pgbouncer:6432/ecolemiriam?pgbouncer=true&connection_limit=30&pool_timeout=15&connect_timeout=15"

# DIRECT_URL contourne PgBouncer (prisma/schema.prisma l.13 l'exige).
#
# ATTENTION — le rôle DOIT être ecolemiriam_owner, PAS ecolemiriam_app.
# Contrairement à ce que laissait entendre ce fichier, DIRECT_URL n'est pas
# réservé à `prisma migrate` : c'est l'URL du client `prisma-base`, utilisé À
# L'EXÉCUTION par tout le chemin d'authentification (recherche de
# l'utilisateur par email au login, deriveClaims, journal d'audit). Ces
# lectures traversent délibérément les frontières tenant et ont lieu AVANT
# qu'une session existe — donc sans `SET LOCAL app.tenant_id`.
#
# Or ecolemiriam_app est NOBYPASSRLS (docker/postgres/init/01-init-roles.sql).
# Avec ce rôle, la policy RLS de la table `users` s'évalue sans contexte
# tenant et ne renvoie AUCUNE ligne : `authorize()` conclut « identifiants
# incorrects » pour absolument tout le monde, et plus personne ne peut se
# connecter. La panne est silencieuse — aucune erreur, aucun log.
#
# Le mot de passe est celui de docker/secrets/postgres_owner_password.txt.
DIRECT_URL="postgresql://ecolemiriam_owner:MOT_DE_PASSE_OWNER@postgres:5432/ecolemiriam?connect_timeout=15"

# Le rôle ecolemiriam_app est NOBYPASSRLS : les policies RLS s'appliquent.
RLS_ACTIVE=true

# --- Cron ---
# openssl rand -hex 32
CRON_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="École Miriam <noreply@ecolemiriam.com>"

# --- Canaux de notification (optionnels) ---
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=EcolPro
WEBHOOK_SMS_SECRET=

# --- Assistant IA (optionnel) ---
GLM_API_KEY=
GLM_API_BASE_URL=https://openrouter.ai/api/v1
GLM_MODEL=

# --- Sauvegardes ---
BACKUP_AGE_KEY=
BACKUP_RCLONE_REMOTE=ecolemiriam-backup
BACKUP_RETENTION_DAYS=30

# ============================================================
# NE PAS AJOUTER ICI :
#   SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
#   → l'infrastructure est 100 % VPS, Supabase n'est plus utilisé.
# ============================================================
